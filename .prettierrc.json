{
  "endOfLine": "auto",
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react",
    "^mobx",
    "^axios$",
    "^clsx$",
    "^dayjs$",
    "^qs$",
    "^uuid$",
    "^[a-zA-Z]",
    "^@/",
    "^\\.",
    "^\\.\\./"
  ]
}
